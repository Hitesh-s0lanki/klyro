# Klyro configuration file.
#
# Copy this to klyro.conf and start the server with:
#
#     klyro klyro.conf
#
# Format: one `name value` pair per line. Everything after a `#` is a
# comment. Blank lines are ignored. Every value below is the default,
# so an empty file behaves exactly like no file at all.
#
# Every parameter here is also readable at runtime with
# `CONFIG GET <name>`, and all but `bind` and `port` can be changed with
# `CONFIG SET <name> <value>` without a restart.

# ----- network -----------------------------------------------------

# Address to listen on. 0.0.0.0 accepts from anywhere; use 127.0.0.1 to
# accept only local connections. Klyro has no authentication, so do not
# expose it on an untrusted network.
bind 0.0.0.0

# Port to listen on.
port 7171

# Connections allowed at once. Past this, a new connection is told
# `ERR max number of clients reached` and closed; INFO's
# rejected_connections counts how often that has happened.
maxclients 10000

# ----- persistence -------------------------------------------------

# Where the keyspace snapshot is written. Loaded at startup if it
# exists. Changing this at runtime redirects the next save and leaves
# the current file alone.
dbfilename klyro.dump

# Seconds between autosave checks. A save happens on a check only if
# something changed since the last one. A crash loses at most this much
# work, so lower it if that matters more than the write cost.
save-interval 60

# ----- keyspace ----------------------------------------------------

# Milliseconds between active sweeps for expired keys. Expired keys are
# also removed lazily whenever they are looked up, so this only bounds
# how long an untouched expired key keeps holding memory.
sweep-interval 1000

# Largest string a value may grow to, in bytes. Enforced by APPEND and
# SETRANGE, which reply an error rather than growing past it. The
# default matches Redis's 512 MB ceiling on a string value.
max-string-bytes 536870912

# ----- protocol -----------------------------------------------------

# Largest bulk string a client may send in one argument. A request over
# this is a protocol error, which closes the connection.
proto-max-bulk-len 536870912

# How much unsent reply may pile up for one client before its
# connection is closed. This is what replaced the old protocol's
# silent 64 KiB reply truncation.
client-output-buffer-limit 268435456

# The COUNT a SCAN uses when the caller doesn't give one.
scan-default-count 10

# Most score/member pairs one ZADD may carry.
zadd-max-pairs 128

# ----- memory limit -------------------------------------------------

# Bytes the process may hold before eviction starts. 0 means no limit,
# and is the default. Accepts Redis's size suffixes: k/m/g are powers
# of a thousand, kb/mb/gb powers of 1024.
#
# This is the whole process, not just the keyspace - client buffers and
# the runtime are inside the number - so a limit below what the server
# needs at rest can never be satisfied.
maxmemory 0

# What to drop once maxmemory is reached. One of:
#
#   noeviction        refuse the writes instead (the default)
#   allkeys-lru       least recently used, from every key
#   allkeys-lfu       least frequently used, from every key
#   allkeys-random    any key
#   volatile-lru      least recently used, among keys with a TTL
#   volatile-lfu      least frequently used, among keys with a TTL
#   volatile-random   any key with a TTL
#   volatile-ttl      the key expiring soonest
#
# A volatile-* policy on a keyspace where nothing carries a TTL has no
# eligible key, and so behaves exactly like noeviction.
maxmemory-policy noeviction

# Keys sampled per eviction round. Eviction is approximate on purpose:
# 5 lands within a couple of percent of true LRU, and a higher number
# buys accuracy at the cost of work per eviction.
maxmemory-samples 5

# ----- memory indexes -----------------------------------------------

# Ceiling on a memory query's TOPK.
mem-max-topk 100

# How many candidates each index contributes before fusion. Above
# mem-max-topk on purpose: fusion can only reorder what it is given, so
# a candidate set no larger than the answer would make the weights
# meaningless.
mem-max-candidates 500

# Ceiling on vector comparisons in one query. Klyro is single-threaded,
# so an unbounded brute-force scan stalls every other client; past this
# the query is refused rather than silently answered from part of the
# index.
mem-max-scan 1000000

# Widest embedding a memory index may be created with. BGE-small is
# 384; the larger open models run to 1024 or 1536.
mem-max-dim 4096

# Ceiling on one memory record's text.
mem-max-text-bytes 65536

# Records per memory index. 0 means no limit - the one parameter here
# where 0 is a setting rather than a mistake.
mem-max-records 0

# Tokenizer cap, so one enormous document cannot dominate the keyword
# index.
mem-max-terms-per-doc 1024

# Default recency half-life for a new index, in seconds. A memory loses
# half its recency score every half-life. MEM.CREATE ... HALFLIFE and
# MEM.CONFIG ... HALFLIFE override it per index.
mem-recency-halflife 604800
