{
  "name": "klyro-client",
  "version": "0.1.0",
  "description": "Official Node.js/TypeScript client for Klyro, a Redis-style in-memory data server.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/tests/*.test.js",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "klyro",
    "redis",
    "client",
    "tcp",
    "in-memory-database"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hitesh-s0lanki/klyro.git",
    "directory": "clients/node"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
